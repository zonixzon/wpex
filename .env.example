# File di configurazione environment per WPEX Docker
# Copia questo file in .env per personalizzare la configurazione

# === CONFIGURAZIONE GENERALE ===
WPEX_VERSION=monitoring-v1.0.0
TZ=Europe/Rome

# === PORTE ===
WPEX_VPN_PORT=40000
WPEX_STATS_PORT=8080

# === CONFIGURAZIONE VPN ===
WPEX_BROADCAST_RATE=3
WPEX_DEBUG=true

# === CONFIGURAZIONE DOCKER ===
CONTAINER_NAME=wpex-server
RESTART_POLICY=unless-stopped

# === VOLUMI ===
WPEX_DATA_DIR=./data
WPEX_LOGS_DIR=./logs

# === CHIAVI PUBBLICHE WIREGUARD (opzionale) ===
# Uncomment e aggiungi le chiavi pubbliche dei peer autorizzati
# WPEX_ALLOW_KEY_1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# WPEX_ALLOW_KEY_2=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# === RETE ===
WPEX_BIND_ADDRESS=0.0.0.0

# === MONITORING ===
WPEX_STATS_BIND=:8080

# === LOGGING ===
LOG_LEVEL=info
LOG_FORMAT=json